    "indices = source_index[selected]; d = native_depth_mm.ravel()[indices]; rays = geom.rays.reshape(-1,3)[indices]",
    "R = geom.r; U,s,Vh = np.linalg.svd(R); R_shadow = U @ np.diag([1,1,np.linalg.det(U @ Vh)]) @ Vh",
    "xyz_recorded = (rays * d[:,None]) @ R.T + geom.t; xyz_shadow = (rays * d[:,None]) @ R_shadow.T + geom.t",
    "uv_recorded = geom.project_xyz(xyz_recorded); uv_shadow = geom.project_xyz(xyz_shadow)",
    "shift_px = uv_shadow - uv_recorded; z_shift_mm = xyz_shadow[:,2] - xyz_recorded[:,2]"
